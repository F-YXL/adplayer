<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dlg_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="小时"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_hour_minus"
            style="@style/StepButton"
            android:text="−" />

        <TextView
            android:id="@+id/text_hour"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="22"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_hour_plus"
            style="@style/StepButton"
            android:text="+" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="分钟"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_minute_minus"
            style="@style/StepButton"
            android:text="−" />

        <TextView
            android:id="@+id/text_minute"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="00"
            android:textColor="@color/accent"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_minute_plus"
            style="@style/StepButton"
            android:text="+" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="用方向键选 + / − 按钮，按 OK 加减；也可直接按数字键"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:text="清除"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_ghost"
            android:text="取消"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_ok"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:text="确定"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
